            }
            else if ($joint == ($nameSpace+$twoDot+"LeftHandThumb3"))
            {
                setCharacterObject($joint,$characterName,52,0);
            }
            else if ($joint == ($nameSpace+$twoDot+"RightHandThumb3"))
            {
                setCharacterObject($joint,$characterName,76,0);
            }
            else if ($joint == ($nameSpace+$twoDot+"LeftHandThumb4"))
            {
