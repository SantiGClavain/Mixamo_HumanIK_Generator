/*
Santi Mixamo HumanIK Generator V3:
Santi Mixamo HumanIK Generator es una  ventana que contiene un par de grupos de �tiles comandos:

1) "Human IK Creation Controls":    
    Este grupo de comandos facilita el trabajo laborioso de crear Human IK Generators seleccionando el hip de un esqueleto de Mixamo y con el nombre que le pongamos en el "Character Name"

2) "Offset Animation COntrols":
    Este super grupo de comandos lo que hace es seleccionar el primer Keyframe del esqueleto y moverlo una cantidad de frames dado en la ventana "Animation Offset" o bien movi�ndolo al frame actual. Es tremendamente r�pido teniendo en cuenta como se hace de forma manual y la precisi�n que hay que tener a ojo.
    Este grupo de funciones es muy �til sobre todo para hacer una librer�a de animaciones para un personaje, o bien para hacer una animaci�n compuesta mezclando animaciones previas para un personaje.


NOTA: Para que estos Scritps funcionen de forma eficiente y teniendo en cuenta la posibilidad de que haya m�s de un esqueleto de Mixamo seleccionado en escena se emplea el uso de NameSpaces (se genera uno de forma temporal para hacer lo que le queremos mandar y luego vuelve a tener el que ten�a, si es que lo ten�a)
*/

{
    {
        string $windowName = "Santi_Mixamo_HumanIK_Generator";
        if (`window -exists $windowName`)        //INIT WINDOW SINGLETON
        {
            deleteUI $windowName;  
        }                                         //END WINDOW SINGLETON
        window -t "Santi Mixamo HumanIK Generator" $windowName;
        	
        	
        columnLayout;
            text -fn boldLabelFont -w 150 -h 30 "Human IK Creation Controls";          
            string $charTextFieldGrp = `textFieldGrp -l "Character Name" -cat 1 left 20 -cal 1 left -cw 1 100 "CharName"`;                
            
            rowLayout -nc 2 -cat 1 left 155;
                text  "Select Character Hip and...";  
                string $goButton = `button -bgc 0.2 0.8 0.2 -l "Press Button"`;
            setParent..;
        
            text -fn boldLabelFont -w 150 -h 30 "Offset Animation Controls ";                
            rowLayout -nc 2 -cat 1 left 35;
                text  -w 100 -bgc 0.50 0.80 1 "Animation Offset";  
                string $OffsetFrameIntFieldGrp = `intField -v 0 "OffsetTime"`;
            setParent..;
            
  //          string $OffsetFrameIntFieldGrp = `intFieldGrp -v1 0 -bgc 0.50 0.80 1 -cat 1 left 20 -cal 1 left -cw 1 100 -l "Offset Animation" "OffsetTime"`;                 
            
            rowLayout -nc 2 -cat 1 left 35;
                text  -h 30 "Select Character Hip and press to set Offset to...";  
                string $offsetButton = `button -bgc 0.50 0.80 1 -l "Animation Offset"`;                        
            setParent..;
            rowLayout -nc 2 -cat 1 left 35;
                text  -h 30 "Select Character Hip and press to set Offset to...";  
                string $offsetCurrentTimeButton = `button -l "CurrentTime" -bgc 0.8 0.3 0.3 -w 85 -c ("SetAnimationToCurrentFrame")`;                                                        
            setParent..;                                                
            
        setParent..;
        
        button -e -c ("StartHumanIKGeneratorCheck " + $charTextFieldGrp) $goButton; // EDIT =         button -e -c ("StartHumanIKGenerator " + $charTextFieldGrp + " " + $OffsetFrameIntFieldGrp) $goButton;
        button -e -c ("CharacterKeyFrameOffsetWindow " + $OffsetFrameIntFieldGrp) $offsetButton;        
        
        int $wWidth = 350 ;
        int $wHeight = 200 ;
        
                    
        showWindow $windowName;
        window -e -wh $wWidth $wHeight $windowName;	 

    
    }
    
    proc StartHumanIKGeneratorCheck (string $nameCharacterTxtFieldGrp)  /// EDIT     proc StartHumanIKGenerator (string $nameCharacterTxtFieldGrp, string $offsetIntGrpName)  
    {
        string $nameCharacterTxtFieldGrpText = `textFieldGrp -q -tx $nameCharacterTxtFieldGrp`;
        if ($nameCharacterTxtFieldGrpText == "" ) 
        {
            //print ("\n Error: Character Name Input Field is Empty, please set a valid name");
            //return;
            string $sceneName = `file -q -ns`;
            textFieldGrp -e -tx ($sceneName + " CS") $nameCharacterTxtFieldGrp;
            StartHumanIKGeneratorCheck ($nameCharacterTxtFieldGrp);
            return;
        }
        
        //Chekeamos que no hay ningun HikCharacter con el mismo nombre que el que hemos puesto en el field $nameCharacterTxtFieldGrp
        string $hikCharList[] = `hikGetSceneCharacters`;
        for( $hikCharName in $hikCharList)
        {
             if ($hikCharName == $nameCharacterTxtFieldGrpText)
             {
               print ("\n ERROR: There are another hikCharacter named " + $nameCharacterTxtFieldGrpText + ". Please choose another name in the Character Name Field");
               return;  
             }   
        }
  
        string $sel[] = `ls -sl`;
        string $hips = $sel[0];
        
        SetTemporalNamespace ($hips);
                        
        ResetMixamoCharacter ($nameCharacterTxtFieldGrpText);    //EDIT         ResetMixamoCharacter ($nameCharacterTxtFieldGrpText, $offsetTimeFrameGrpValue);    
    
    }
    
    proc CreateMixamoHumanIK (string $hipJoint, string $character)    //Esta funci�n sirve para crear un Human IK a partir de una jerarqu�a de mixamo, tiene en cuenta si tiene namespace, pero no tiene en cuenta la ruta completa de los nombres cuando hay m�s de un esqueleto en escena.
    {    
          
        //Esto es para detectar si hay un root INIT
        
        string $nameSpaceList[] = `ls -showNamespace $hipJoint`;
        int $isRoot = 0;
        string $twoDot = ":";   
        string $nameSpace = $nameSpaceList[1];
        print ("\n Namespace is: " + $nameSpace);
        select -r $hipJoint;
        string $parentHipList[] = `pickWalk -d up`;
        string $parentHip = $parentHipList[0];
        if($parentHip != $hipJoint)
        {
            string $rootObject = $parentHip;
            print ("\n Root object is = " + $rootObject);
            $isRoot = 1;
        }
        
              
        //Esto es para detectar si hay un root END
                
        string $characterName = `hikCreateCharacter($character)`;        
        string $jointList[] = `listRelatives -ad -type "joint" $hipJoint`;
        setCharacterObject($hipJoint,$characterName,1,0);
        
        if($isRoot == 1)
        {
            setCharacterObject($parentHip,$characterName,0,0);
        }
        
