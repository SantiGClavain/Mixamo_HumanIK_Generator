    proc ResetMixamoCharacter (string $nameCharacterReset) //Esta funci�n selecciona toda la jerarqu�a de joints y las resetea, solo sirve para jerarqu�as exportadas de Mixamo -------- EDIT     proc ResetMixamoCharacter (string $nameCharacterReset, int $offsetFrame)
    {
        int $storedTime = `currentTime -query`;
    
        string $selectionList[] = `ls -sl`;
        string $hipMixamoJoint = $selectionList[0];
        
        int $firstKF = GetFirstKey ($hipMixamoJoint);
        
        int $resetTime = $firstKF -20;
    
        currentTime $resetTime; 
           
        setAttr ($hipMixamoJoint + ".translateX") 0;
        setAttr ($hipMixamoJoint + ".translateY") 99.672;
        setAttr ($hipMixamoJoint + ".translateZ") 0; 
        setAttr ($hipMixamoJoint + ".rotateX") 0;
        setAttr ($hipMixamoJoint + ".rotateY") 0;
        setAttr ($hipMixamoJoint + ".rotateZ") 0;
        
        string $jointList[] = `listRelatives -ad -type "joint" $hipMixamoJoint`;
        
        for($joint in $jointList)
        {
            setAttr ($joint + ".rotateX") 0;
            setAttr ($joint + ".rotateY") 0;
            setAttr ($joint + ".rotateZ") 0;
        } 
        
        CreateMixamoHumanIK ($hipMixamoJoint, $nameCharacterReset);
        
        select -hierarchy;
        timeSliderClearKey;  
        
        currentTime $storedTime;
                             
    }
    
    proc CharacterKeyFrameOffset (int $offsetTime) //Esta funci�n selecciona la jerarqu�a del objeto seleccionado y mueve todos los KF seleccionables una cantidad dada ($offsetTime)
    {    
        string $selList[] = `ls -sl`; 
        string $jointHip = $selList[0];
        select -r $jointHip;
        
        string $charSkeleton[] = `SelectHierarchy`;
        
        string $charAnimCurveList[] = `listConnections -type animCurve`;
        for($anim in $charAnimCurveList)
        {
            keyframe -e -iub true -r -o over -tc $offsetTime $anim;
        }
    }
    
    proc CharacterKeyFrameOffsetWindow (string $offsetTimeGrp)
    {   
        int $offsetTime = `intField -q -v $offsetTimeGrp`; 
        string $selList[] = `ls -sl`; 
        string $jointHip = $selList[0];
        select -r $jointHip;
        
        string $charSkeleton[] = `SelectHierarchy`;
        
        string $charAnimCurveList[] = `listConnections -type animCurve`;
        for($anim in $charAnimCurveList)
        {
            keyframe -e -iub true -r -o over -tc $offsetTime $anim;
        }
    }
    
    proc SetAnimationToCurrentFrame ()        //
    {
       string $selList[] = `ls -sl`;
       string $hipJoint = $selList[0];
       
       int $firstKey = `GetFirstKey $hipJoint`;
       int $offsetToApply = `CalculeRelativeOffset $firstKey`;
       
       select -r $hipJoint;
       
       CharacterKeyFrameOffset($offsetToApply);    
    }
    
    proc int GetFirstKey (string $jointHipGetFirstKey)        //Esta funci�n nos permite poder acceder al primer keyframe del channel box de una jerarqu�a y nos devuelve el frame que corresponde
    {

       int $storedTimelineMin = `playbackOptions -q -min`;
       int $storedTimelineMax = `playbackOptions -q -max`;
       select -r $jointHipGetFirstKey;
       SelectHierarchy;
       
       setPlaybackRangeToMinMax;
       
       int $firstAnimationKey = `playbackOptions -q -min`;
       
       playbackOptions -min $storedTimelineMin -max $storedTimelineMax; 
       
       return $firstAnimationKey;          
    }
    
    proc int CalculeRelativeOffset (int $firstKeyFrame)    //Esta funci�n toma el valor del current time y nos hace la diferencia respecto al valor $firstKeyFrame
    {
        int $OffsetToSet = 0;
        int $currentKF =  `currentTime -q`;
                
        $OffsetToSet = ($currentKF - $firstKeyFrame);
        
        return $OffsetToSet;
    }
    
    proc InvalidHikCharactersCleaner()
    {
        string $hikCharList[] = `hikGetSceneCharacters`;

        for ($hikCharName in $hikCharList)
        {
            optionMenuGrp -e -v $hikCharName hikCharacterList;
            hikUpdateCurrentCharacterFromUI();
            hikGetCurrentCharacter;
            int $isValid = `hikIsCharacterizationInValidOrWarningState`;
            if($isValid == 0)
            {
                deleteCharacter($hikCharName);
            }
        }
    }
    
    proc SetTemporalNamespace (string $hipObject)
    {      
        string $skeleton[] = `GetRealTransformHierarchy $hipObject`;
        
        string $temporalNamespace = "SantiTemporalNameSpace";
        
        string $namesp[] = `ls -showNamespace $skeleton[0]`;
        
        string $namespace = $namesp[1];
        
        $namespace = $namespace + ":" + $temporalNamespace;
               
        string $buffer[];
        $buffer = stringToStringArray ($namespace, ":");    
        
        if (size($buffer) == 1) //
        {
            $temporalNamespace  = `GetSingleNamespace $temporalNamespace`;
            
        }
        else{
            
            $temporalNamespace  = `GetSingleNamespace ($namespace + ":" + $temporalNamespace)`;
        }                           
        

        int $i;
        for ($i = 0; $i < size($skeleton); $i++ )
        {
            string $buffer[];
            
            $buffer = stringToStringArray ($skeleton[$i], ":");
            int $size = `size $buffer`;
           

            $buffer =  stringToStringArray ($buffer[$size-1], "|");
            $size = `size $buffer`;
             
            string $targetName = $buffer[$size-1];
            string $renamedName = ($namespace + ":" + $targetName);
            
            if(`objExists $skeleton[$i]`){
                rename $skeleton[$i] (":" + $renamedName);
            }
            $skeleton = `GetRealTransformHierarchy $skeleton[0]`;            
        }
       
    }
    
    proc string[] GetRealTransformHierarchy (string $object)
    {
         
         string $hierarchy[];
         
         $hierarchy[0] = $object;
         
         string $childrenList[] = `listRelatives -ad -f -type "transform"`;
         int $i;
         for ($i = 0; $i  < size($childrenList); $i++)
         {
             int $hierarchyIndex = $i + 1;
             $hierarchy[$hierarchyIndex] = $childrenList[$i];             
         }
         
         return $hierarchy;
    }    
    
    proc string GetSingleNamespace (string $proposedNamespace)
    {        
        int $isNamespace = `namespace -exists (":" + $proposedNamespace)`;
        if($isNamespace != 0)
        {
            $proposedNamespace = GetSingleNamespace($proposedNamespace + "Dup");  
        }
        
        return $proposedNamespace;
        
    }
    
    proc RemoveLastNamespace (string $hipsTempNamespaced)
    {
        string $namesp[] = `ls -showNamespace $hipsTempNamespaced`;
        string $buffer[];
        string $namespace = $namesp[1];
        
        $buffer = stringToStringArray ($namespace, ":");    
        
        if (size($buffer) == 1) //
        {
            namespace -set ":";
            namespace -mergeNamespaceWithParent -removeNamespace $namespace;
            
        }
        else{
            namespace -set ":";
            namespace -mergeNamespaceWithParent -removeNamespace $namespace;
        }
               
    }
    
    proc changeDrawStyleToBone ()
    {
        string $sel[] = `ls -sl`;
        int $i = 0;
    
        for ($i = 0; size($sel); $i++)
        {
            setAttr ($sel[$i] + ".drawStyle") 0;
        }
    }  
    
    
}
