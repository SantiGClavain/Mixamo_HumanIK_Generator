string $leftSidePoly[] = `polyUnite -ch 1 -mergeUVSets 1 -objectPivot -n "SantiLeftSide"`;
DeleteHistory;
polyMirrorFace  -cutMesh 0 -axis 0 -axisDirection 1 -mergeMode 1 -mergeThresholdType 1 -mergeThreshold 0.001 -mirrorAxis 2 -mirrorPosition 0 -smoothingAngle 30 -flipUVs 0 -ch 1 $leftSidePoly[0];
polySoftEdge -a 180 -ch 1 ($leftSidePoly[0] + ".e[0:8359]");

