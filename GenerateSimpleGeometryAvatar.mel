/*
Simple geometry avatar generator placeholder.
Creates a basic hip cube for blocking out volumes.
*/
{

string $bodyCentalMeshesArray[];
string $hipMeshA[] = `polyCube -n "Santi_Hip" -w 10 -h 10 -d 10 -sd 2 -sh 2 -sw 2`;
string $hipMesh = $hipMeshA[0];
$bodyCentalMeshesArray[size($bodyCentalMeshesArray)] = $hipMesh;
int $hipDelFaces[] = {0, 2, 4, 6, 8, 10, 12, 14, 20, 21, 22, 23};
select -cl;
for ($faces in $hipDelFaces){select -add ($hipMesh + ".f[" + $faces +"]");}
doDelete;
select -r ($hipMesh + ".vtx[0]");move -r 0 92.404579 5.406258 ;
