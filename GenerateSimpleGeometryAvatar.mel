proc float[] ReadWorldPosition () 
{
    float $result[] = {0,0,0};
    
    string $itemA[] = `ls -sl`;
    string $item = $itemA[0];
    
    float $wPos[] = `xform -q -ws -t $item`;   // {x,y,z}
    $result = $wPos;
    string $command = 
    "move -ws " 
    + string($result[0]) + " " 
    + string($result[1]) + " " 
    + string($result[2]) + ";";
    print $command;
    copyToClipboard $command;   
    return $result;    
}

global proc copyToClipboard(string $text)
{
    print ("Running copyToClipboard \n");
    python(
        "from PySide6 import QtWidgets; " +
        "cb = QtWidgets.QApplication.clipboard(); " +
        "cb.setText(repr(" + "\"" + $text + "\"" + ")[1:-1]);"
    );
}

global proc SelectVertexByIndex (int $i)
{
    string $selA[] = `ls -sl`;
    string $object = $selA[0];
    
    select -r ($object +".vtx[" + string($i) + "]");
    ReadWorldPosition;
    select -r $object;
}

global proc CreateProceduralModel (string $variableName)
{
    string $selection[] = `ls -sl`;
    string $selectedObject = $selection[0];
    int $vtxCountA[] = `polyEvaluate -v $selectedObject`;
    int $vtxCount = $vtxCountA[0];
    int $i = 0;
    string $selectMoveCommand = "";
    for ($i = 0; $i < ($vtxCount); $i++)
    {
        //Generamos el comando para seleccionar el vertex
        string $selectCommand  = ("select -r (" + $variableName + " + \".vtx[" + string($i) + "]\"); ");
        //string $item = "";
        //$item = ($selectedObject + ".vtx[" + string($i) + "]");
        float $wp[] = {0,0,0};        
        float $wPos[] = `xform -q -ws -t ($selectedObject + ".vtx[" + string($i) + "]")`;   // {x,y,z} Coge los valores globales de la posiciión del vertex
        $wp = $wPos;
        //Creamos el comando move para hacer copy paste
        string $moveCommand = 
        "move -ws " 
        + string($wPos[0]) + " " 
        + string($wPos[1]) + " " 
        + string($wPos[2]) + ";";

        $selectMoveCommand += ($selectCommand + $moveCommand + "\n"); 
    }

    //copyToClipboard $selectMoveCommand; //Esto no funciona porque el texto que genera es muy grande y con muchos saltos de linea, habría que depurar copyToClipboard
    print $selectMoveCommand;   
    //return $selectMoveCommand;  //Esto se ha desactivado porque es más comodo para copiar en el Script Editor que no salga el result como comentario
    
}